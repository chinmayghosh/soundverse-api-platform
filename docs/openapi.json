  "webhooks": {
    "generation.succeeded | generation.failed | generation.canceled": {
      "post": {
        "summary": "Event delivered to your endpoint",
        "description": "Header Soundverse-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, `${t}.${raw body}`)>. Verify over the raw body, reject if |now - t| > 300 s, dedupe on event id. Respond 2xx within 10 s; otherwise we retry with backoff for ~24 h.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
