# Copy to .env for `npm run dev` / `npm run worker` on the host.
# docker compose already has working local defaults; in that case .env only
# needs FAL_KEY (and LIVE_PROVIDER=fal) if you want live keys to call the real model.

APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://soundverse:soundverse@localhost:5432/soundverse

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=
WEBHOOK_SECRET_ENC_KEY=
BETTER_AUTH_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-secret
S3_BUCKET=soundverse-audio
AUDIO_URL_TTL_SEC=3600

# mock | fal. Test keys ALWAYS use the mock regardless of this setting.
LIVE_PROVIDER=mock
FAL_KEY=
# Hard cap on real provider calls (protects the model budget).
LIVE_PROVIDER_MAX_CALLS=20
MOCK_LATENCY_MS=3000
MOCK_FAILURE_RATE=0

KEY_ROTATION_GRACE_SEC=86400
# Only for local development; production requires https webhook URLs.
ALLOW_HTTP_WEBHOOKS=true
